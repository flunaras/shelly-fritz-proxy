[Unit]
Description=Shelly Pro 3 EM emulator backed by a FRITZ!Smart Energy 250
Documentation=https://github.com/flunaras/shelly-fritz-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Settings are read from /etc/shelly-fritz-proxy/shelly-fritz-proxy.conf.
# Edit that file to configure the FRITZ!Box credentials, listen address,
# phase-mapping mode, etc.
#
# To override individual settings without editing either file, create a
# drop-in (systemctl edit shelly-fritz-proxy). Example:
#   [Service]
#   ExecStart=
#   ExecStart=/usr/bin/shelly-fritz-proxy \
#     --config /etc/shelly-fritz-proxy/shelly-fritz-proxy.conf \
#     --listen :8080 \
#     --log-level debug
ExecStart=/usr/bin/shelly-fritz-proxy --config /etc/shelly-fritz-proxy/shelly-fritz-proxy.conf
Restart=on-failure
RestartSec=5s

# Run as a transient dynamic user — systemd allocates an unprivileged
# UID/GID at service start time; no pre-created account is required.
# DynamicUser=yes implies ProtectSystem=strict, so the root filesystem is
# mounted read-only; the service can still read world-readable files such
# as /etc/shelly-fritz-proxy/shelly-fritz-proxy.conf (installed mode 644).
DynamicUser=yes

# A real Shelly device listens on port 80 and many Shelly-aware clients
# (including the Solakon ONE) hard-code that port. CAP_NET_BIND_SERVICE
# is the minimum capability needed for an unprivileged user to bind to
# ports < 1024. mDNS works without additional capabilities because
# 224.0.0.251:5353 is unprivileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security hardening (several are implied by DynamicUser=yes, listed
# here explicitly for auditability).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Network: the service needs IPv4 (HTTP + mDNS) and IPv6 if your LAN
# uses it; UNIX is needed for stdout/journal pipes.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
